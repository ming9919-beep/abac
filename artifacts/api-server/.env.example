# ── ABA PayWay ──────────────────────────────────────────────
# Set PAYWAY_MODE=live only when you have valid merchant credentials.
# The API key / RSA keys below are PLACEHOLDERS — replace with your own.
PAYWAY_MODE=mock
PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
PAYWAY_MERCHANT_ID=ec474150
PAYWAY_API_KEY=REPLACE_WITH_YOUR_40_CHAR_PUBLIC_KEY
PAYWAY_RSA_PUBLIC_KEY_FILE=keys/payway-public.pem
PAYWAY_RSA_PRIVATE_KEY_FILE=keys/payway-private.pem

# ── Bakong (NBC) Open API ───────────────────────────────────
# BAKONG_MODE=live requires a real developer token (BAKONG_TOKEN).
# NEVER commit the real token. Use mock mode for local testing.
BAKONG_MODE=mock
BAKONG_TOKEN=REPLACE_WITH_YOUR_BAKONG_TOKEN
BAKONG_PROD_BASE=https://api-bakong.nbc.gov.kh
BAKONG_EMAIL=

# ── Server ──────────────────────────────────────────────────
PORT=5200

# ── Wallet / 钱包数据库 ─────────────────────────────────────
# 数据库驱动：
#   postgres（默认）— 真正的 PostgreSQL，需要下面的 DATABASE_URL
#   pglite           — 嵌入式 PostgreSQL（WASM），零安装，本地演示/冒烟用：
#                      WALLET_DB_DRIVER=pglite，数据在 WALLET_PGDATA 目录，
#                      首次启动自动执行 lib/db/migrations/*.sql
WALLET_DB_DRIVER=
WALLET_PGDATA=.wallet-pglite
WALLET_AUTO_MIGRATE=true
WALLET_MIGRATIONS_DIR=../../lib/db/migrations

# 数据库连接串（迁移执行器、钱包服务共用）。
# 应用连接建议用 wallet_app 角色（无 DDL、不能改 ledger/audit 只追加表）。
DATABASE_URL=postgresql://wallet_admin:CHANGE_ME_LOCAL_ONLY@127.0.0.1:5432/wallet_dev

# 证件号 AES-256-GCM 主密钥：32 字节的 base64。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WALLET_ENCRYPTION_KEY=

# 证件号 HMAC-SHA256 pepper（唯一哈希用；与加密密钥分开保管）
WALLET_ID_PEPPER=

# 管理端接口 X-Admin-Key（审批/对账/审计查询）
WALLET_ADMIN_KEY=

# 单笔超过该金额（单位「元」）自动进入 requires_review 待审批
WALLET_REVIEW_THRESHOLD=1000

# 会话有效期（小时）
WALLET_SESSION_TTL_HOURS=72

# 关闭注册后，只允许已注册手机号登录（未注册一律 PHONE_NOT_REGISTERED）
WALLET_ALLOW_REGISTRATION=true

# 渠道回调验签共享密钥（HMAC-SHA256）；生产必须用渠道公钥验签
WALLET_PROVIDER_WEBHOOK_SECRET=
